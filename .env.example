# Sao chép file này thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env
# Lấy key tại https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Model nhẹ cho học sinh ảo + phân loại, model mạnh hơn cho chấm điểm + Coach (tên lấy trong AI Studio).
# gemini-flash-latest luôn trỏ tới bản Flash mới nhất. Muốn cố định một bản (kết quả ổn định khi thí điểm), ghi tên cụ thể, ví dụ gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_STRONG=gemini-flash-latest
# Giới hạn thời gian (giây): 1 lần gọi Gemini / tổng thời gian Coach Agent được nghĩ (quá thì dùng luật dự phòng)
LLM_TIMEOUT_SEC=40
COACH_BUDGET_SEC=25
# 1 = không gọi Gemini, trả lời giả (test luồng, không tốn quota)
FAKE_LLM=0
# 1 = bật endpoint /api/sessions/{id}/debug cho CLI xem trạng thái ẩn của Nam. Tắt khi deploy thật.
DEBUG=1
# Nơi lưu database SQLite (mặc định backend/tutorsim.sqlite3)
DB_PATH=
# Chỉ dùng lỗi sai đã được giáo viên duyệt (trang_thai = Đồng ý). 0 = dùng cả lỗi đang chờ duyệt
ONLY_APPROVED=0
# Địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# ===== Đăng nhập =====
# BẮT BUỘC đặt khi deploy. Tạo chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
# 1 = gia sư, học sinh tự đăng ký được trên web
ALLOW_REGISTER=1
# 1 = tạo sẵn tài khoản thử minh, lan, tuan (gia sư), ha, khoa (học sinh). ĐẶT 0 KHI DEPLOY THẬT
SEED_DEMO=1
DEMO_PASSWORD=demo1234
# Tài khoản quản lý trung tâm (không tự đăng ký được). Tạo khi khởi động nếu chưa có
MANAGER_USERNAME=quanly
MANAGER_PASSWORD=
